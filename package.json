{
	"name": "automatic-editor-sorter",
	"displayName": "Automatic Editor Sorter",
	"description": "Automatically sort yours editors",
	"version": "0.1.2",
	"author": {
		"name": "Baptiste Augrain",
		"email": "daiyam@zokugun.org"
	},
	"publisher": "zokugun",
	"license": "MIT",
	"homepage": "https://github.com/zokugun/vscode-automatic-editor-sorter",
	"repository": {
		"type": "git",
		"url": "https://github.com/zokugun/vscode-automatic-editor-sorter.git"
	},
	"bugs": {
		"url": "https://github.com/zokugun/vscode-automatic-editor-sorter/issues"
	},
	"engines": {
		"vscode": "^1.73.0"
	},
	"main": "./lib/index.js",
	"browser": "./lib/index.js",
	"scripts": {
		"audit:fix": "npm audit fix --min-release-age=0",
		"build": "npm run clean && npm run compile:src && npm run bundle",
		"bundle": "ncc build out/extension --out lib",
		"ci:lint": "zizmor .",
		"ci:lint:fix": "zizmor . --fix=all",
		"clean": "rimraf lib out *.vsix",
		"compile:src": "tsc -p src",
		"lint": "xo",
		"lint:all": "npm run lint:package && npm audit && npm run ci:lint && npm run lint",
		"lint:fix": "xo --fix",
		"lint:package": "fixpack || true",
		"package": "rimraf *.vsix && vsce package",
		"prepare": "husky; npm run lint:package",
		"release": "release-it",
		"update:artifacts": "artifact update",
		"update:ci": "PINACT_MIN_AGE=7 pinact run --update",
		"update:deps": "taze --all",
		"vscode:prepublish": "npm run build",
		"watch:src": "tsc-watch -p src --onSuccess 'npm run bundle'"
	},
	"dependencies": {},
	"devDependencies": {
		"@commitlint/cli": "20.5.3",
		"@commitlint/config-conventional": "20.5.3",
		"@types/node": "20.19.43",
		"@types/vscode": "1.73.0",
		"@vercel/ncc": "0.44.0",
		"@vscode/vsce": "3.9.2",
		"fixpack": "4.0.0",
		"husky": "9.1.7",
		"lint-staged": "16.4.0",
		"release-it": "20.2.0",
		"rimraf": "6.1.3",
		"taze": "19.14.1",
		"tsc-watch": "7.2.0",
		"typescript": "5.9.3",
		"xo": "0.60.0"
	},
	"overrides": {
		"release-it": {
			"undici": "7.28.0"
		}
	},
	"allowScripts": {
		"@vscode/vsce-sign": true,
		"keytar": true
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"configuration": {
			"title": "Automatic Editor Sorter",
			"properties": {
				"automaticEditorSorter.enabled": {
					"title": "Enabled",
					"type": "boolean",
					"default": true,
					"description": "Controls whether open editors are sorted or not."
				},
				"automaticEditorSorter.notification": {
					"type": "string",
					"enum": [
						"none",
						"major",
						"minor",
						"patch"
					],
					"enumDescriptions": [
						"The new version notification won't be shown anymore.",
						"The new version notification will be shown only with a new major version",
						"The new version notification will be shown only with a new minor version",
						"The new version notification will always be shown"
					],
					"default": "minor",
					"scope": "application"
				},
				"automaticEditorSorter.order": {
					"title": "Sort Order",
					"type": "string",
					"default": "asc",
					"description": "Controls in which direction the open editors are sorted.",
					"enum": [
						"asc",
						"desc"
					],
					"enumDescriptions": [
						"The open editors are sorted from A to Z.",
						"The open editors are sorted from Z to A."
					]
				},
				"automaticEditorSorter.rule": {
					"title": "Sort Rule",
					"type": "string",
					"default": "name",
					"description": "Controls how the open editors are sorted.",
					"enum": [
						"absolute",
						"name",
						"name,absolute"
					],
					"enumDescriptions": [
						"The open editors are sorted by their absolute path.",
						"The open editors are sorted by their name then, by their parent's name.",
						"The open editors are sorted by their name then, by their absolute path."
					]
				}
			}
		}
	},
	"icon": "icon.png",
	"galleryBanner": {
		"color": "#ffffff",
		"theme": "light"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"editor",
		"sort",
		"sorter",
		"sorting",
		"tab"
	],
	"extensionKind": [
		"ui",
		"workspace"
	]
}
